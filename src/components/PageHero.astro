---
interface Props {
  eyebrow: string;
  title: string;
  lead?: string;
  numeral?: string;
}

const { eyebrow, title, lead, numeral } = Astro.props;
---

<section class="plate-dark relative overflow-hidden pt-36 pb-20 sm:pt-44 sm:pb-24">
  <div class="shell">
    <p class="eyebrow-light flex items-center gap-4">
      {numeral && <span aria-hidden="true">{numeral}</span>}
      {numeral && <span class="h-px w-10 bg-gold-500/50" aria-hidden="true"></span>}
      <span>{eyebrow}</span>
    </p>

    <h1
      class="mask-line mt-7 text-[clamp(2.4rem,6.8vw,5.25rem)] text-parchment-50"
      data-reveal-line
    >
      <span>{title}</span>
    </h1>

    {lead && <p class="mt-7 max-w-2xl text-lg leading-relaxed text-parchment-200/70">{lead}</p>}

    <div
      class="mt-12 h-px w-full bg-gradient-to-r from-gold-500/40 to-transparent"
      aria-hidden="true"
    ></div>
  </div>
</section>
