---
import { CONTENT } from '../data/content';
import { withBase } from '../utils/paths';

const { identity } = CONTENT;
---

<div class="seal" data-seal>
  <svg class="seal__ring" viewBox="0 0 200 200" aria-hidden="true" focusable="false">
    <defs>
      <path id="seal-ring-path" d="M100,100 m-86,0 a86,86 0 1,1 172,0 a86,86 0 1,1 -172,0" />
    </defs>
    <g data-seal-ring>
      <text class="seal__text">
        <textPath href="#seal-ring-path" textLength="540" lengthAdjust="spacing">
          {identity.sealRing}
        </textPath>
      </text>
    </g>
    <circle cx="100" cy="100" r="68" fill="none" stroke="currentColor" stroke-opacity="0.3" />
    <circle cx="100" cy="100" r="63" fill="none" stroke="currentColor" stroke-opacity="0.12" />
    <circle cx="100" cy="100" r="93" fill="none" stroke="currentColor" stroke-opacity="0.16" />
  </svg>

  <span class="seal__disc">
    <img
      src={withBase('/logo-seal.webp')}
      alt={identity.sealAlt}
      width="512"
      height="512"
      loading="eager"
      fetchpriority="high"
      decoding="async"
    />
  </span>
</div>

<style>
  .seal {
    position: relative;
    display: grid;
    place-items: center;
    width: min(78vw, 26rem);
    aspect-ratio: 1;
    color: var(--color-gold-400);
  }

  .seal__ring {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  .seal__text {
    fill: currentColor;
    font-family: var(--font-display);
    font-size: 8.5px;
    font-weight: 500;
    letter-spacing: 0.34em;
    text-transform: uppercase;
  }

  .seal__disc {
    display: block;
    width: 62%;
    aspect-ratio: 1;
    overflow: hidden;
    border-radius: 9999px;
    background: var(--color-ink-950);
    box-shadow:
      0 0 0 1px color-mix(in oklab, var(--color-gold-500) 35%, transparent),
      0 30px 90px -40px color-mix(in oklab, var(--color-gold-500) 55%, transparent);
  }

  .seal__disc img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transform: scale(1.14);
  }
</style>
