---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import SectionHeading from '../components/SectionHeading.astro';
import Ornament from '../components/Ornament.astro';
import LogoMark from '../components/LogoMark.astro';
import { CONTENT } from '../data/content';
import { withBase } from '../utils/paths';

const { about, cv, contact, identity, ui } = CONTENT;

/** Biyografi paragraflarını anahtarla getirir (metinler cv.bio içinde). */
const bio = (key: keyof typeof cv.bio) => cv.bio[key];

const credentials = [
  { label: about.card.labels.name, value: identity.fullName },
  { label: about.card.labels.location, value: contact.location },
  { label: about.card.labels.activity, value: about.card.activityValue },
];
---

<BaseLayout title={about.seo.title} description={about.seo.description}>
  <PageHero
    numeral={about.hero.numeral}
    eyebrow={about.hero.eyebrow}
    title={about.hero.title}
    lead={about.hero.lead}
  />

  <!-- ========================== BİYOGRAFİ ========================== -->
  <section class="section" aria-labelledby={about.biography.id}>
    <div class="shell grid gap-16 lg:grid-cols-[1fr_0.55fr] lg:gap-24">
      <div>
        <SectionHeading
          id={about.biography.id}
          numeral={about.biography.numeral}
          eyebrow={about.biography.eyebrow}
          title={about.biography.title}
        />

        <div class="mt-10 space-y-6 text-[1.05rem] leading-relaxed text-stone-600">
          {about.biography.paragraphs.map((key) => (
            <p data-reveal>{bio(key)}</p>
          ))}
        </div>

        <Ornament class="mt-14 max-w-[10rem] lg:mx-0" />
      </div>

      <aside class="lg:sticky lg:top-32 lg:self-start" aria-label={about.card.aria}>
        <div class="border border-ink-900/12 bg-parchment-100/70 p-8" data-reveal>
          <LogoMark size="lg" />

          <dl class="mt-8 space-y-6">
            {credentials.map((item) => (
              <div>
                <dt class="font-display text-[0.55rem] uppercase tracking-[0.4em] text-gold-700">
                  {item.label}
                </dt>
                <dd class="mt-2 leading-relaxed text-ink-900">{item.value}</dd>
              </div>
            ))}
            <div>
              <dt class="font-display text-[0.55rem] uppercase tracking-[0.4em] text-gold-700">
                {about.card.labels.languages}
              </dt>
              <dd class="mt-2 leading-relaxed text-ink-900">
                {cv.languages.map((language) => (
                  <span class="block">
                    {language.name}
                    <span class="text-stone-500"> — {language.level}</span>
                  </span>
                ))}
              </dd>
            </div>
            <div>
              <dt class="font-display text-[0.55rem] uppercase tracking-[0.4em] text-gold-700">
                {about.card.labels.link}
              </dt>
              <dd class="mt-2">
                <a
                  class="link-rule break-all text-ink-900"
                  href={contact.linkedin}
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  {contact.linkedinLabel}
                </a>
              </dd>
            </div>
          </dl>
        </div>
      </aside>
    </div>
  </section>

  <!-- =========================== EĞİTİM =========================== -->
  <section class="section bg-parchment-100" aria-labelledby={about.education.id}>
    <div class="shell">
      <SectionHeading
        id={about.education.id}
        numeral={about.education.numeral}
        eyebrow={about.education.eyebrow}
        title={about.education.title}
      />

      <ol class="mt-16 grid gap-px overflow-hidden border border-ink-900/10 bg-ink-900/10 sm:grid-cols-3">
        {cv.education.map((item) => (
          <li class="bg-parchment-50 p-8" data-reveal>
            <p class="font-display text-[0.6rem] uppercase tracking-[0.38em] text-gold-700">
              {item.period}
            </p>
            <p class="mt-5 font-display text-xl leading-snug text-ink-900">{item.degree}</p>
            <p class="mt-3 leading-relaxed text-stone-600">{item.school}</p>
            {item.note && <p class="mt-4 text-sm italic text-stone-500">{item.note}</p>}
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- ================== DENEYİM & STAJ DENEYİMİ ================== -->
  <section class="section" aria-labelledby={about.experience.id}>
    <div class="shell grid gap-16 lg:grid-cols-2 lg:gap-24">
      <div>
        <SectionHeading
          id={about.experience.id}
          numeral={about.experience.numeral}
          eyebrow={about.experience.eyebrow}
          title={about.experience.title}
        />

        {cv.experience.map((item) => (
          <article class="mt-12 border-t border-ink-900/12 pt-8" data-reveal>
            <p class="font-display text-[0.6rem] uppercase tracking-[0.38em] text-gold-700">
              {item.period}
            </p>
            <h3 class="mt-4 font-display text-2xl text-ink-900">{item.role}</h3>
            <p class="mt-2 text-stone-600">{item.org}</p>

            <ul class="mt-7 space-y-3.5 leading-relaxed text-stone-600">
              {item.items.map((entry) => (
                <li class="flex gap-4">
                  <span class="mt-3 h-px w-5 shrink-0 bg-gold-500" aria-hidden="true" />
                  <span>{entry}</span>
                </li>
              ))}
            </ul>
          </article>
        ))}
      </div>

      <div>
        <SectionHeading
          numeral={about.internships.numeral}
          eyebrow={about.internships.eyebrow}
          title={about.internships.title}
        />

        <ol class="mt-12 space-y-12">
          {cv.internships.map((item) => (
            <li class="border-l border-gold-500/35 pl-7" data-reveal>
              <p class="font-display text-[0.6rem] uppercase tracking-[0.38em] text-gold-700">
                {item.period}
              </p>
              <h3 class="mt-4 font-display text-xl text-ink-900">{item.org}</h3>
              <ul class="mt-5 space-y-3 leading-relaxed text-stone-600">
                {item.items.map((entry) => (
                  <li class="flex gap-4">
                    <span class="mt-3 h-px w-5 shrink-0 bg-gold-500" aria-hidden="true" />
                    <span>{entry}</span>
                  </li>
                ))}
              </ul>
            </li>
          ))}
        </ol>
      </div>
    </div>
  </section>

  <!-- ========================= ÜYELİKLER ========================= -->
  <section class="plate-dark section" aria-labelledby={about.memberships.id}>
    <div class="shell">
      <SectionHeading
        id={about.memberships.id}
        tone="dark"
        numeral={about.memberships.numeral}
        eyebrow={about.memberships.eyebrow}
        title={about.memberships.title}
      />

      <ul class="mt-16 grid gap-px overflow-hidden border border-gold-500/18 bg-gold-500/15 sm:grid-cols-3">
        {cv.memberships.map((item) => (
          <li class="bg-ink-950/80 p-8" data-reveal>
            <p class="font-display text-[0.6rem] uppercase tracking-[0.38em] text-gold-500">
              {item.period}
            </p>
            <p class="mt-5 font-display text-xl leading-snug text-parchment-50">{item.org}</p>
            <p class="mt-3 leading-relaxed text-parchment-200/65">{item.role}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- ======================== SERTİFİKALAR ======================== -->
  <section class="section" aria-labelledby={about.certifications.id}>
    <div class="shell">
      <SectionHeading
        id={about.certifications.id}
        numeral={about.certifications.numeral}
        eyebrow={about.certifications.eyebrow}
        title={about.certifications.title}
      />

      <ul class="mt-14 grid gap-x-14 sm:grid-cols-2">
        {cv.certifications.map((item) => (
          <li
            class="flex items-baseline justify-between gap-6 border-b border-ink-900/12 py-6"
            data-reveal
          >
            <span>
              <span class="block font-display text-[1.05rem] leading-snug text-ink-900">
                {item.title}
              </span>
              <span class="mt-1.5 block text-[0.92rem] leading-relaxed text-stone-500">
                {item.org}
              </span>
            </span>
            <span class="text-[0.7rem] text-gold-600" aria-hidden="true">
              ◆
            </span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- ======================== YETKİNLİKLER ======================== -->
  <section class="section bg-parchment-100" aria-labelledby={about.skills.id}>
    <div class="shell grid gap-16 lg:grid-cols-[0.8fr_1fr] lg:gap-24">
      <SectionHeading
        id={about.skills.id}
        numeral={about.skills.numeral}
        eyebrow={about.skills.eyebrow}
        title={about.skills.title}
        lead={about.skills.lead}
      />

      <div class="grid gap-12 sm:grid-cols-2">
        {cv.skills.map((group) => (
          <div data-reveal>
            <h3 class="rule-label">{group.title}</h3>
            <ul class="mt-8 space-y-4 leading-relaxed text-stone-600">
              {group.items.map((item) => (
                <li class="flex gap-4">
                  <span
                    class="mt-3.5 h-1 w-1 shrink-0 rounded-full bg-gold-500"
                    aria-hidden="true"
                  />
                  <span>{item}</span>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ============================ CTA ============================ -->
  <section class="section" aria-label={about.cta.aria}>
    <div class="shell text-center">
      <Ornament class="mx-auto max-w-[11rem]" />
      <h2 class="mx-auto mt-10 max-w-2xl text-[clamp(1.8rem,4vw,2.8rem)]" data-reveal>
        {about.cta.title}
      </h2>
      <div class="mt-10 flex flex-wrap justify-center gap-4" data-reveal>
        <a href={withBase('/iletisim/')} class="btn btn-ink">
          {ui.buttons.appointment}
        </a>
        <a href={withBase('/faaliyet-alanlari/')} class="btn btn-ghost-dark">
          {ui.buttons.practiceAreas}
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
