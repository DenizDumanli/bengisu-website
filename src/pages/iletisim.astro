---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import ContactForm from '../components/ContactForm.astro';
import Ornament from '../components/Ornament.astro';
import { CONTENT } from '../data/content';

const { contact, contactPage, ui } = CONTENT;
const { form } = contactPage;

interface ChannelLink {
  value: string;
  href: string | null;
  external: boolean;
}

/** Kanal bilgileri tek kaynaktan (`contact`) beslenir. */
const channelLinks: Record<(typeof contactPage.channels)[number]['id'], ChannelLink> = {
  phone: { value: contact.phone, href: `tel:${contact.phoneHref}`, external: false },
  email: { value: contact.email, href: `mailto:${contact.email}`, external: false },
  linkedin: { value: contactPage.linkedinValue, href: contact.linkedin, external: true },
  location: { value: contact.location, href: null, external: false },
};

const channels = contactPage.channels.map((channel) => ({
  ...channel,
  ...channelLinks[channel.id],
}));
---

<BaseLayout title={contactPage.seo.title} description={contactPage.seo.description}>
  <PageHero
    numeral={contactPage.hero.numeral}
    eyebrow={contactPage.hero.eyebrow}
    title={contactPage.hero.title}
    lead={contactPage.hero.lead}
  />

  <section class="section" aria-labelledby="kanallar">
    <div class="shell">
      <h2 id="kanallar" class="sr-only">
        {contactPage.channelsHeading}
      </h2>

      <ul class="grid gap-px overflow-hidden border border-ink-900/12 bg-ink-900/12 sm:grid-cols-2">
        {channels.map((channel) => (
          <li class="bg-parchment-50 p-8 sm:p-10" data-reveal>
            <p class="font-display text-[0.55rem] uppercase tracking-[0.42em] text-gold-700">
              {channel.label}
            </p>

            <p class="mt-5 font-display text-xl leading-snug text-ink-900">
              {channel.href ? (
                <a
                  class="link-rule break-all"
                  href={channel.href}
                  target={channel.external ? '_blank' : undefined}
                  rel={channel.external ? 'noopener noreferrer' : undefined}
                >
                  {channel.value}
                </a>
              ) : (
                channel.value
              )}
            </p>

            <p class="mt-3 text-[0.92rem] leading-relaxed text-stone-500">{channel.note}</p>
          </li>
        ))}
      </ul>

      <p class="mt-10 max-w-2xl text-[0.95rem] leading-relaxed text-stone-500" data-reveal>
        {ui.notes.confidentiality}
      </p>
    </div>
  </section>

  <section class="plate-dark section" aria-labelledby={form.id}>
    <div class="shell grid gap-16 lg:grid-cols-[0.7fr_1fr] lg:gap-20">
      <div>
        <p class="eyebrow-light" data-reveal>
          {form.eyebrow}
        </p>
        <h2 id={form.id} class="mt-6 text-[clamp(1.9rem,4.4vw,3rem)] text-parchment-50" data-reveal>
          {form.title}
        </h2>
        <p class="mt-7 max-w-md leading-relaxed text-parchment-200/70" data-reveal>
          {form.text}
        </p>

        <Ornament class="mt-12 max-w-[10rem] justify-start" />

        <dl class="mt-12 space-y-6 text-[0.95rem]">
          <div>
            <dt class="font-display text-[0.55rem] uppercase tracking-[0.42em] text-gold-500">
              {contactPage.details.phone}
            </dt>
            <dd class="mt-2">
              <a class="link-rule text-parchment-100" href={`tel:${contact.phoneHref}`}>
                {contact.phone}
              </a>
            </dd>
          </div>
          <div>
            <dt class="font-display text-[0.55rem] uppercase tracking-[0.42em] text-gold-500">
              {contactPage.details.email}
            </dt>
            <dd class="mt-2">
              <a class="link-rule break-all text-parchment-100" href={`mailto:${contact.email}`}>
                {contact.email}
              </a>
            </dd>
          </div>
          <div>
            <dt class="font-display text-[0.55rem] uppercase tracking-[0.42em] text-gold-500">
              {contactPage.details.location}
            </dt>
            <dd class="mt-2 text-parchment-200/75">{contact.location}</dd>
          </div>
        </dl>
      </div>

      <div data-reveal>
        <ContactForm />
      </div>
    </div>
  </section>
</BaseLayout>
